# Copy to .env (or set in Railway → Variables). Every variable is optional —
# missing ones put that module into demo mode.

# Server
PORT=3000

# Phase 2 — YouTube Data API v3 (Google Cloud Console → enable API → create key)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Phase 3 — Hermes agent on your VPS
HERMES_URL=
HERMES_TOKEN=
